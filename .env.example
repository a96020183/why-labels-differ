# Copy to .env (or ../.env) only for LIVE mode. SAMPLE_MODE needs no keys at all.
SAMPLE_MODE=true

# Meterless Nightshift (the only model provider). The NVIDIA key lives in Nightshift, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=<your-nightshift-runtime-token>

# Local Zetaris
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<administrator-api-key-used-only-for-setup-and-EXPLAIN>
# Created by scripts/setup_zetaris.py into data/private/ (or set them here)
ZETARIS_AGENT_API_KEY=<agent-role-api-key>
ZETARIS_PHARMACIST_API_KEY=<pharmacist-role-api-key>

# Offline comparison only (S'); never used by the app
OPENAI_API_KEY=<optional>

# Nightshift scope: the product sends the Power contract's "meterless-scope: user" by default. Recording and evaluation
# runs (APRIME_RECORD=true) send a fresh iso-<uuid> per request instead (README explains why). METERLESS_SCOPE=iso
# forces iso; METERLESS_SCOPE=user forces user even when recording.
# METERLESS_SCOPE=
